<Window x:Class="VideoPlayer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="다봐 · ohmyplayer" Height="570" Width="780" MinHeight="570" MinWidth="690"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#E6EEF6" Foreground="#173047"
        Icon="pack://application:,,,/Assets/ohmyplayer.ico" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#DDFBFDFF"/><SolidColorBrush x:Key="Muted" Color="#526B80"/><SolidColorBrush x:Key="Ink" Color="#173047"/><SolidColorBrush x:Key="Accent" Color="#167F7B"/><SolidColorBrush x:Key="Line" Color="#BED0DE"/><BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <DropShadowEffect x:Key="SoftShadow" Color="#72899B" BlurRadius="18" ShadowDepth="3" Opacity="0.14"/>
        <Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="#F4FFFFFF"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FFFFFFFF"/><Setter TargetName="Surface" Property="BorderBrush" Value="#86AFC2"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DDEBF3"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="TextBox"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="#F7FAFD"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,8"/><Setter Property="CaretBrush" Value="{StaticResource Accent}"/></Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="11"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="False" Background="Transparent" MouseLeftButtonDown="WindowTitleArea_MouseLeftButtonDown">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="38" Height="38" CornerRadius="11" Background="#F4FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1"><Image Source="/Assets/ohmyplayer.png" Width="35" Height="35" Stretch="Uniform"/></Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="다봐" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="EditionLabel" Text="ohmyplayer" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,1,0,0"/></StackPanel>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="×" Click="CloseWindow_Click" ToolTip="닫기" Padding="10,7" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="—" Click="MinimizeWindow_Click" ToolTip="최소화" Padding="10,7"/>
            <Button DockPanel.Dock="Right" Content="⚙ 설정" Click="Settings_Click" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="업데이트 확인" Click="CheckUpdates_Click" Margin="0,0,8,0"/>
            <Button DockPanel.Dock="Right" Content="＋ 파일 추가" Click="OpenFiles_Click" Background="{StaticResource Accent}" Foreground="White" BorderBrush="{StaticResource Accent}"/>
        </DockPanel>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="UrlBox" Grid.Column="0" Height="38" VerticalContentAlignment="Center" ToolTip="직접 재생 가능한 MP4, MKV 등의 영상 URL" KeyDown="UrlBox_KeyDown"/>
            <Button Grid.Column="1" Content="URL 열기" Click="PlayUrl_Click" Margin="7,0,0,0" Background="{StaticResource Accent}" Foreground="White" BorderBrush="{StaticResource Accent}"/>
            <Button x:Name="DownloadUrlButton" Grid.Column="2" Content="URL 다운로드" Click="DownloadUrl_Click" Margin="7,0,0,0"/>
        </Grid>
        <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="13" Padding="10" Effect="{StaticResource SoftShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <TextBlock Text="위치" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="4,4,0,8"/>
                    <Button x:Name="LocalSourceButton" Content="내 컴퓨터" Tag="local" Click="LocalSource_Click" HorizontalContentAlignment="Left" Background="#DCEEF2" BorderBrush="#86AFC2"/>
                    <TextBlock Text="클라우드" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="4,18,0,8"/>
                    <Button x:Name="GoogleSourceButton" Content="Google Drive · 미연결" Tag="Google Drive" Click="CloudSource_Click" HorizontalContentAlignment="Left" Margin="0,0,0,5" Padding="8,7"/>
                    <Button x:Name="MyBoxSourceButton" Content="Naver MYBOX" Tag="Naver MYBOX" Click="CloudSource_Click" HorizontalContentAlignment="Left" Margin="0,0,0,5" Padding="8,7"/>
                    <Button x:Name="OneDriveSourceButton" Content="OneDrive · 미연결" Tag="OneDrive" Click="CloudSource_Click" HorizontalContentAlignment="Left" Margin="0,0,0,5" Padding="8,7"/>
                    <Button x:Name="DropboxSourceButton" Content="Dropbox · 미연결" Tag="Dropbox" Click="CloudSource_Click" HorizontalContentAlignment="Left" Margin="0,0,0,5" Padding="8,7"/>
                    <Button x:Name="PikPakSourceButton" Content="PikPak · 설정 필요" Tag="PikPak" Click="CloudSource_Click" HorizontalContentAlignment="Left" Padding="8,7" Margin="0,0,0,5"/>
                    <TextBlock Text="내 저장소" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="4,18,0,8"/>
                    <StackPanel x:Name="StorageSourceButtons"/>
                    <Button Content="＋ 저장소 연결" Click="ManageStorage_Click" HorizontalContentAlignment="Left" Margin="0,6,0,0" Padding="8,7"/>
                    <TextBlock Text="로그인 연결과 동기화 폴더를 단계별로 지원합니다." TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource Muted}" Margin="5,10,3,0"/>
                </StackPanel></ScrollViewer>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="13" Padding="14" Effect="{StaticResource SoftShadow}">
                <Grid>
                    <Grid x:Name="LocalContent"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="1,0,1,10"><StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="내 컴퓨터" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="PlaylistCount" Text="0개" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Bottom" Margin="7,0,0,2"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ClearPlaylistButton" Content="모두 지우기" Click="ClearPlaylist_Click" Padding="8,5" Margin="0,0,6,0" Background="Transparent" BorderBrush="Transparent" Foreground="{StaticResource Muted}" Visibility="Collapsed"/><Button Content="＋ 파일" Click="OpenFiles_Click" Padding="9,5"/></StackPanel></DockPanel>
                        <Border Grid.Row="1" Background="#F7FAFD" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="7"><Grid>
                            <ListBox x:Name="PlaylistList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Ink}" MouseDoubleClick="PlaylistList_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,7"/><Setter Property="Margin" Value="0,0,0,3"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#DCEEF2"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#ECF4F8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate><DataTemplate><Grid MinHeight="38"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Grid.Column="0" Content="▶" Click="PlayPlaylistItem_Click" ToolTip="재생" AutomationProperties.Name="재생" Foreground="{StaticResource Accent}" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="4"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{StaticResource Ink}"/><TextBlock Text="{Binding DisplayLocation}" TextTrimming="CharacterEllipsis" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="URL" Visibility="{Binding IsRemote, Converter={StaticResource BoolToVisibilityConverter}}" Foreground="{StaticResource Muted}" FontSize="9" VerticalAlignment="Center" Margin="8,0,3,0"/><Button Grid.Column="3" Content="×" Click="RemovePlaylistItem_Click" ToolTip="목록에서 제거" AutomationProperties.Name="목록에서 제거" Padding="7,3" Margin="5,0,0,0" Background="Transparent" BorderBrush="Transparent" Foreground="{StaticResource Muted}"/></Grid></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="PlaylistEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><Image Source="/Assets/ohmyplayer.png" Width="42" Height="42"/><TextBlock Text="목록이 비어 있어요" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,9,0,4"/><TextBlock Text="파일을 추가하거나 URL을 입력하세요" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                        </Grid></Border>
                    </Grid>
                    <Grid x:Name="CloudContent" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Grid.Row="0" Margin="1,0,1,10"><Button x:Name="CloudBackButton" Content="↑ 위로" Click="CloudBack_Click" Padding="8,5" Margin="0,0,9,0" Visibility="Collapsed"/><StackPanel VerticalAlignment="Center"><TextBlock x:Name="CloudTitle" Text="저장소" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="CloudStatusText" Text="저장소를 선택하세요." FontSize="10" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel><Button Content="연결 설정" Click="ManageStorage_Click" DockPanel.Dock="Right" Padding="8,5"/></DockPanel><Border Grid.Row="1" Background="#F7FAFD" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="7"><ListBox x:Name="CloudFilesList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Ink}" SelectionChanged="CloudFilesList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid MinHeight="34"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="EntryGlyph" Grid.Column="0" Text="▶" Foreground="{StaticResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Ink}"/><TextBlock Grid.Column="2" Text="{Binding DisplaySize}" Foreground="{StaticResource Muted}" FontSize="9" VerticalAlignment="Center" Margin="8,0,4,0"/></Grid><DataTemplate.Triggers><DataTrigger Binding="{Binding IsFolder}" Value="True"><Setter TargetName="EntryGlyph" Property="TextBlock.Text" Value="▰"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate></ListBox></Border></Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
