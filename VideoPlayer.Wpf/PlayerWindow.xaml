<Window x:Class="VideoPlayer.Wpf.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="다봐 · ohmyplayer" Width="960" Height="600" MinWidth="520" MinHeight="340"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#050608" Foreground="#EDF4F7"
        Icon="pack://application:,,,/Assets/ohmyplayer.ico" KeyDown="Window_KeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#36C8B0"/><SolidColorBrush x:Key="Ink" Color="#EDF4F7"/><SolidColorBrush x:Key="Muted" Color="#B8C7D2"/><SolidColorBrush x:Key="Line" Color="#567080"/>
        <DropShadowEffect x:Key="SoftShadow" Color="#72899B" BlurRadius="18" ShadowDepth="3" Opacity="0.18"/>
        <Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="#263640"/><Setter Property="BorderBrush" Value="#40525F"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#344B58"/><Setter TargetName="Surface" Property="BorderBrush" Value="#668797"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#415B68"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#173047"/><Setter Property="Background" Value="#F7FAFD"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="6,3"/><Setter Property="MinWidth" Value="115"/></Style>
    </Window.Resources>
    <Grid x:Name="PlayerRoot" Background="#050608">
        <Grid x:Name="PlatformContainer" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Background="#121B26" LastChildFill="False" MouseLeftButtonDown="TopChrome_MouseLeftButtonDown"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="브라우저에서 열기" Click="OpenExternal_Click"/><Button Content="—" Click="Minimize_Click" Margin="6,0,0,0"/><Button Content="×" Click="Close_Click" Margin="6,0,0,0"/></StackPanel><Button Content="＋ 파일 선택" Click="OpenFile_Click"/><Button Content="전체화면" Click="Fullscreen_Click" Margin="6,0,0,0"/></DockPanel><wv2:WebView2 Grid.Row="1" x:Name="PlatformWebView"/></Grid>
        <vlc:VideoView x:Name="VideoView">
        <Grid Background="#01000000" PreviewMouseMove="PlayerRoot_PreviewMouseMove" PreviewTouchDown="PlayerRoot_PreviewTouchDown" MouseLeftButtonDown="VideoView_MouseLeftButtonDown" PreviewKeyDown="Window_KeyDown" Focusable="True">
        <StackPanel x:Name="EmptyState" Panel.ZIndex="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><Image Source="/Assets/ohmyplayer.png" Width="66" Height="66"/><TextBlock Text="영상 창" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" Foreground="White"/><TextBlock Text="재생목록에서 영상을 선택하거나 파일을 여세요" Foreground="#D3DFE9" FontSize="12" HorizontalAlignment="Center"/></StackPanel>
        <Border x:Name="TopChrome" VerticalAlignment="Top" Panel.ZIndex="2" HorizontalAlignment="Stretch" Background="#99121B26" BorderThickness="0" CornerRadius="12" Margin="14" Padding="10,8" MouseLeftButtonDown="TopChrome_MouseLeftButtonDown">
            <DockPanel LastChildFill="False"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="OpenExternalButton" Content="브라우저에서 열기" Click="OpenExternal_Click" Visibility="Collapsed" Padding="10,6"/><Button Content="—" Click="Minimize_Click" ToolTip="최소화" Padding="10,6" Margin="6,0,0,0"/><Button Content="×" Click="Close_Click" ToolTip="재생 창 닫기" Padding="10,6" Margin="6,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal"><Button Content="＋ 파일 선택" Click="OpenFile_Click" Padding="10,6"/><Button Content="프레임 캡처 · Ctrl+C" Click="CaptureFrame_Click" Margin="7,0,0,0" Padding="10,6"/></StackPanel></DockPanel>
        </Border>
        <Border x:Name="PlaybackControls" VerticalAlignment="Bottom" Panel.ZIndex="2" Background="#99121B26" BorderThickness="0" CornerRadius="14" Margin="14" Padding="14,11"><StackPanel>
            <Slider x:Name="SeekSlider" Minimum="0" Maximum="1000" Value="0" IsMoveToPointEnabled="True" PreviewMouseDown="SeekSlider_PreviewMouseDown" PreviewMouseUp="SeekSlider_PreviewMouseUp" ValueChanged="SeekSlider_ValueChanged"/>
            <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0" LastChildFill="False" VerticalAlignment="Center"><TextBlock x:Name="TimeLabel" DockPanel.Dock="Left" Text="00:00 / 00:00" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" Width="88"/><Button x:Name="PlayPauseButton" DockPanel.Dock="Left" Content="▶ 재생" Click="PlayPause_Click" Background="{StaticResource Accent}" Foreground="#09211F" BorderBrush="{StaticResource Accent}"/><Button x:Name="StopButton" DockPanel.Dock="Left" Content="■ 정지" Click="Stop_Click" Margin="6,0,0,0"/><Button x:Name="PreviousButton" DockPanel.Dock="Left" Content="⏮ 이전" Click="Previous_Click" Margin="6,0,0,0"/><Button x:Name="NextButton" DockPanel.Dock="Left" Content="다음 ⏭" Click="Next_Click" Margin="6,0,0,0"/></DockPanel>
                <TextBlock x:Name="NowPlayingText" Grid.Column="1" Text="재생할 영상 없음" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="11" Margin="12,0" Foreground="#EAF2F8"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="볼륨" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/><Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="80" Width="84" ValueChanged="VolumeSlider_ValueChanged"/><TextBlock x:Name="VolumeValue" Text="80%" Foreground="{StaticResource Ink}" FontSize="10" Width="32" VerticalAlignment="Center" TextAlignment="Right"/><Button x:Name="MuteButton" Content="음소거" Click="MuteButton_Click" Margin="6,0,0,0" Padding="8,5"/></StackPanel>
            </Grid>
            <DockPanel LastChildFill="False" Margin="0,7,0,0"><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><ComboBox x:Name="AudioTracks" SelectionChanged="AudioTracks_SelectionChanged"/><ComboBox x:Name="SubtitleTracks" Width="145" Margin="6,0,0,0" SelectionChanged="SubtitleTracks_SelectionChanged"/><Button x:Name="OpenSubtitleButton" Content="자막 열기" Click="OpenSubtitle_Click" Margin="6,0,0,0" Padding="9,5"/><Button x:Name="GenerateCaptionButton" Content="CC 생성" Click="GenerateCaption_Click" Margin="6,0,0,0" Padding="9,5"/><CheckBox x:Name="CaptionVoice" Content="자막 읽기" Margin="8,0,0,0" VerticalAlignment="Center" Checked="CaptionVoice_Changed" Unchecked="CaptionVoice_Changed"/></StackPanel><Button x:Name="PipButton" DockPanel.Dock="Right" Content="PIP" Click="Pip_Click" Margin="6,0,0,0" Padding="10,5"/><Button x:Name="FullscreenButton" DockPanel.Dock="Right" Content="전체화면" Click="Fullscreen_Click" Padding="10,5"/></DockPanel>
        </StackPanel></Border>
        </Grid></vlc:VideoView>
    </Grid>
</Window>
