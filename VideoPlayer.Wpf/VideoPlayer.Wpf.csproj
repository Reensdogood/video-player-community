<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ohmyplayer</AssemblyName>
    <Product>다봐 (ohmyplayer)</Product>
    <ApplicationIcon>Assets\ohmyplayer.ico</ApplicationIcon>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Version>0.1.17</Version>
    <StartupObject>VideoPlayer.Wpf.App</StartupObject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <Resource Include="Assets\ohmyplayer.png" />
    <Resource Include="Assets\ohmyplayer.ico" />
    <Content Include="Tools\transcribe_cc.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
